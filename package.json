{
  "name": "someterm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @someterm/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @someterm/desktop dev",
    "build:desktop": "pnpm --filter @someterm/desktop build",
    "dist:desktop": "pnpm --filter @someterm/desktop dist",
    "test:native": "cargo test -p someterm-native",
    "check:native": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
